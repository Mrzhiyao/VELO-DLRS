# Copy to .env and fill in. Real environment variables take precedence over this file.
# Relative paths are resolved against the repository root.

# ---- data ----
# default: data/tasks/single_node (single_node) or data/tasks/multi_node (edge)
# VELO_DATA_DIR=data/tasks/single_node
# default: data/expert/single_node or data/expert/multi_node
# VELO_EXPERT_DIR=data/expert/single_node

# ---- Milvus ----
VELO_MILVUS_PORT=19530
# single_node / trainer: Milvus of edge node 1,2,3 (comma separated, in node order)
VELO_MILVUS_HOSTS=127.0.0.1,127.0.0.1,127.0.0.1
# multi_node/edge: Milvus of this edge node
VELO_EDGE_MILVUS_HOST=127.0.0.1
# Milvus holding historical LLM answers (collection oasst1_llm_result)
VELO_LLM_CACHE_MILVUS_HOST=127.0.0.1

# ---- embedding service (Towhee + Triton) ----
VELO_TRITON_URL=localhost:8010

# ---- cloud LLM (OpenAI-compatible API) ----
VELO_LLM_BASE_URL=http://127.0.0.1:8000/v1
VELO_LLM_API_KEY=EMPTY
VELO_LLM_MODEL=qwen-7b-chat-int8

# ---- multi-node deployment ----
# id of this edge node (1/2/3); upload port = VELO_TRAINER_BASE_PORT + VELO_NODE_ID
VELO_NODE_ID=1
VELO_EDGE_COLLECTION=diffusion_two_input11_0150_6000
VELO_EDGE_SEND_COLLECTION=diffusion_two_input_nodes11_0150_6000
VELO_TRAINER_HOST=127.0.0.1
VELO_TRAINER_BIND_HOST=0.0.0.0
VELO_TRAINER_BASE_PORT=40060

# trainer -> edge weight push over FTP (users ftpnode1/ftpnode2/ftpnode3)
VELO_EDGE_FTP_HOSTS=127.0.0.1,127.0.0.1,127.0.0.1
VELO_FTP_USER_PREFIX=ftpnode
VELO_FTP_PASSWORD=
VELO_FTP_REMOTE_WEIGHT_PATH=/var/ftp/upload/model_network.pth

# edge: where the pushed weights land, and the initial (expert pre-trained) weights
VELO_EDGE_WEIGHT_PATH=/var/ftp/upload/model_network.pth
VELO_INIT_WEIGHT_PATH=weights/pretrained.pth
